# ---- Application ----
APP_ENV=local            # local | testing | production
APP_DEBUG=false
APP_URL=https://mentor.versalynx.net
APP_TIMEZONE=UTC
APP_KEY=                 # run: php bin/console key:generate

# ---- Database (MySQL 8+) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=researchmentor
DB_USERNAME=researchmentor
DB_PASSWORD=change-me

# ---- Storage (must be OUTSIDE the web root) ----
PRIVATE_STORAGE_PATH=/var/www/researchmentor/storage/private
EXPORT_STORAGE_PATH=/var/www/researchmentor/storage/exports
MAX_UPLOAD_MB=25

# ---- Sessions / security ----
SESSION_NAME=rm_session
SESSION_LIFETIME_MINUTES=120
SESSION_SECURE_COOKIE=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- AI (Anthropic Claude Messages API) ----
AI_ENABLED=true
AI_PROVIDER=auto          # auto | claude | mock  (auto = Claude if key set, else mock outside production)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_MAX_TOKENS=8000
AI_TIMEOUT=120
AI_MAX_RETRIES=3
AI_EFFORT=medium            # low|medium|high|xhigh|max (leave empty for models without effort support)
AI_MAX_INPUT_CHARS=120000   # per request; longer documents use staged analysis
AI_RATE_LIMIT_PER_HOUR=30   # per user

# ---- Background work ----
QUEUE_DRIVER=sync         # sync (inline) | database (processed by bin/worker.php)

# ---- Data protection ----
DEFAULT_RETENTION_DAYS=1825
